        </mxCell>
        <mxCell id="loop2" value="rollback → 재설계" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=1;dashed=1;fontSize=9;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="out_rollback" target="s_design">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="782"/><mxPoint x="130" y="303"/></Array></mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

