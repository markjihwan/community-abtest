{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(experiments/*.md)|Edit(experiments/*.md)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-guardrail-register.sh",
            "statusMessage": "Guardrail 누락 여부 확인 중..."
          },
          {
            "type": "command",
            "if": "Write(experiments/*.md)|Edit(experiments/*.md)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-guardrail-ship.sh",
            "statusMessage": "Ship 전 Guardrail 체크 확인 중..."
          }
        ]
      }
    ]
  }
}
